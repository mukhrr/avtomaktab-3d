  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "city:fetch": "tsx tools/city/fetch.ts",
    "bench:sim": "tsx tools/bench/sim.ts",
    "city:build": "tsx tools/city/build.ts",
    "exam:route": "tsx tools/exam/route.ts",
    "model:gentra": "tsx tools/model/gentra.ts",
    "signs:fetch": "tsx tools/signs/fetch.ts",
    "signs:atlas": "tsx tools/signs/atlas.ts",
    "signs:credits": "tsx tools/signs/credits.ts",
    "signs:spots": "tsx tools/signs/coverageSpots.ts"
