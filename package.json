  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "4.3",
    "fast-xml-parser": "4.5",
    "sharp": "^0.35.5",
    "tsx": "4.19",
    "typescript": "5.6",
